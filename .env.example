# Required: the Bearer token that OpenObserve will present.
O2_JUDGE_AUTH_TOKEN=changeme

# Backend selection. Any LiteLLM provider name works. See README for the
# full list. Common values: openai, openai_compatible, anthropic, azure,
# gemini, vertex_ai, bedrock, cohere, mistral, groq, deepseek,
# together_ai, fireworks_ai, ollama.
O2_JUDGE_PROVIDER=openai

# Required for every backend.
O2_JUDGE_API_KEY=sk-...
O2_JUDGE_MODEL=gpt-4o-mini

# Required for openai_compatible; optional override for ollama / azure /
# self-hosted variants of any provider.
# O2_JUDGE_URL=http://internal-llm:8000/v1

# Optional. LLM-call timeout in seconds, default 60.
# O2_JUDGE_TIMEOUT_SECONDS=60

# Optional listen address. Default 0.0.0.0:8000.
# O2_JUDGE_HOST=0.0.0.0
# O2_JUDGE_PORT=8000

# ─────────────────────────────────────────────────────────────────────
# Examples for other providers (uncomment one set):
# ─────────────────────────────────────────────────────────────────────
#
# Anthropic Claude:
# O2_JUDGE_PROVIDER=anthropic
# O2_JUDGE_API_KEY=sk-ant-...
# O2_JUDGE_MODEL=claude-3-5-sonnet-20241022
#
# Google AI Studio (Gemini):
# O2_JUDGE_PROVIDER=gemini
# O2_JUDGE_API_KEY=AIza...
# O2_JUDGE_MODEL=gemini-1.5-pro
#
# Google Vertex AI:
# O2_JUDGE_PROVIDER=vertex_ai
# O2_JUDGE_API_KEY=unused-but-required
# O2_JUDGE_MODEL=gemini-1.5-pro
# GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcp-sa.json
# VERTEXAI_PROJECT=my-gcp-project
# VERTEXAI_LOCATION=us-central1
#
# AWS Bedrock:
# O2_JUDGE_PROVIDER=bedrock
# O2_JUDGE_API_KEY=unused-but-required
# O2_JUDGE_MODEL=anthropic.claude-3-sonnet-20240229-v1:0
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION_NAME=us-east-1
#
# Azure OpenAI:
# O2_JUDGE_PROVIDER=azure
# O2_JUDGE_API_KEY=...
# O2_JUDGE_MODEL=my-deployment-name
# O2_JUDGE_URL=https://<resource>.openai.azure.com
# AZURE_API_VERSION=2024-08-01-preview
#
# Groq:
# O2_JUDGE_PROVIDER=groq
# O2_JUDGE_API_KEY=gsk_...
# O2_JUDGE_MODEL=llama-3.1-70b-versatile
#
# DeepSeek:
# O2_JUDGE_PROVIDER=deepseek
# O2_JUDGE_API_KEY=sk-...
# O2_JUDGE_MODEL=deepseek-chat
#
# Ollama (local):
# O2_JUDGE_PROVIDER=ollama
# O2_JUDGE_API_KEY=unused-but-required
# O2_JUDGE_MODEL=llama3
# O2_JUDGE_URL=http://host.docker.internal:11434
#
# Local OpenAI-compatible (vLLM, llama.cpp, TGI, …):
# O2_JUDGE_PROVIDER=openai_compatible
# O2_JUDGE_API_KEY=any-non-empty-string
# O2_JUDGE_MODEL=llama-3.1-70b-instruct
# O2_JUDGE_URL=http://internal-llm:8000/v1
